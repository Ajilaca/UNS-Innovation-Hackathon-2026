# Salin ke .env lalu isi. .env TIDAK boleh masuk git.
BJ_ADMIN_USER=admin
BJ_ADMIN_PASSWORD=ganti-dengan-sandi-kuat
BJ_SECRET=ganti-dengan-hasil-`openssl rand -hex 32`
BJ_DEMO=1                              # 1 = tombol "Masuk sebagai demo" (baca-saja)
# kunci HTTP perangkat: unit_id:kunci,unit_id:kunci  (opsional; MQTT memakai sandi sendiri)
BJ_DEVICE_KEYS=

MQTT_BACKEND_PASSWORD=ganti
INFLUX_USER=admin
INFLUX_PASSWORD=ganti-dengan-sandi-kuat
INFLUX_TOKEN=ganti-dengan-hasil-`openssl rand -hex 32`
INFLUX_ORG=batikjernih
INFLUX_BUCKET=telemetry

# hanya untuk docker-compose.online.yml
BJ_DOMAIN=batikjernih.duckdns.org
DUCKDNS_SUBDOMAIN=batikjernih
DUCKDNS_TOKEN=token-dari-duckdns.org
